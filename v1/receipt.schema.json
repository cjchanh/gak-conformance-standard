{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gak-conformance/v1/receipt.schema.json",
  "title": "GAK Conformance Receipt",
  "description": "Spec §5.1 receipt. Documentation only — the harness does not validate against this schema at runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": ["kernel", "profile", "conformant", "counts", "clauses"],
  "properties": {
    "kernel": { "type": "string" },
    "profile": { "type": "string", "enum": ["action-gate", "commit-gate"] },
    "conformant": { "type": "boolean" },
    "counts": {
      "type": "object",
      "required": ["pass", "fail", "na"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "na": { "type": "integer", "minimum": 0 }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "profile", "status", "detail"],
        "properties": {
          "id": { "type": "string" },
          "profile": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NA"] },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "not": { "required": ["timestamp"] }
}
